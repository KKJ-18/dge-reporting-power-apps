// Map de tous les départements
export const DEPARTMENTS_MAP = {
  DA: DA_DEPARTMENT,
  DSE: DSE_DEPARTMENT,
  DPNP: DPNP_DEPARTMENT
};

// Liste de tous les départements
export const ALL_DEPARTMENTS = [DA_DEPARTMENT, DSE_DEPARTMENT, DPNP_DEPARTMENT];

// Fonction helper pour obtenir un département
export function getDepartment(deptId: 'DA' | 'DSE' | 'DPNP'): DepartmentData {
  return DEPARTMENTS_MAP[deptId];
}

// Fonction helper pour obtenir une catégorie
export function getCategory(deptId: 'DA' | 'DSE' | 'DPNP', categoryId: string): CategoryData | undefined {
  return DEPARTMENTS_MAP[deptId].categories.find(cat => cat.id === categoryId);
}

// Fonction helper pour obtenir toutes les catégories d'un département
export function getDepartmentCategories(deptId: 'DA' | 'DSE' | 'DPNP'): CategoryData[] {
  return DEPARTMENTS_MAP[deptId].categories;
}

// Fonction helper pour obtenir le nombre total d'activités d'un département
export function getDepartmentActivityCount(deptId: 'DA' | 'DSE' | 'DPNP'): number {
  return DEPARTMENTS_MAP[deptId].categories.reduce((sum, cat) => sum + cat.activities.length, 0);
}
