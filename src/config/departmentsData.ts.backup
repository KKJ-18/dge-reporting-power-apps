/**
 * Structure des données des départements
 * Définit les catégories et activités pour chaque département
 */

export interface ActivityItem {
  id: string;
  label: string;
  unit?: string; // Unité de mesure (nombre, montant, etc.)
  type?: 'number' | 'amount' | 'text' | 'date'; // Type de saisie
}

export interface CategoryData {
  id: string;
  name: string;
  activities: ActivityItem[];
  icon?: string;
}

export interface DepartmentData {
  id: 'DA' | 'DSE' | 'DPNP';
  name: string;
  fullName: string;
  icon: string;
  color: string;
  categories: CategoryData[];
}

