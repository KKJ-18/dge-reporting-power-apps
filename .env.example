# Configuration pour l'environnement DGE Reporting

# SharePoint Configuration
VITE_SHAREPOINT_SITE_URL=https://your-tenant.sharepoint.com/sites/DGEReporting
VITE_SHAREPOINT_LIST_NAME=ReportsHebdomadaires
VITE_SHAREPOINT_LIBRARY_NAME=DocumentsReporting

# Power Automate Flow URLs
VITE_EXPORT_FLOW_URL=https://prod-xx.westeurope.logic.azure.com:443/workflows/xxxxx/triggers/manual/paths/invoke
VITE_REMINDER_FLOW_URL=https://prod-xx.westeurope.logic.azure.com:443/workflows/xxxxx/triggers/manual/paths/invoke
VITE_VALIDATION_FLOW_URL=https://prod-xx.westeurope.logic.azure.com:443/workflows/xxxxx/triggers/manual/paths/invoke

# Power BI Configuration
VITE_POWERBI_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_POWERBI_REPORT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_POWERBI_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Application Configuration
VITE_APP_TITLE=Plateforme de Reporting DGE
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development